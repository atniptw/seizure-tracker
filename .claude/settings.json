{
  "enabledPlugins": {
    "kotlin-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "hookify@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/scan-staged-secrets.sh",
            "if": "Bash(git commit*)",
            "timeout": 15,
            "statusMessage": "Scanning staged changes for secrets..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/flag-unpushed-main.sh",
            "timeout": 15,
            "statusMessage": "Checking for unpushed commits on main..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/watch-main-ci.sh gitpush",
            "if": "Bash(git push*)",
            "timeout": 45,
            "statusMessage": "Checking for a freshly-triggered CI run on main..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/watch-main-ci.sh ghmerge",
            "if": "Bash(gh pr merge*)",
            "timeout": 45,
            "statusMessage": "Checking for a freshly-triggered CI run on main..."
          }
        ]
      }
    ]
  }
}
