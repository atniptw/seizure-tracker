{
  "permissions": {
    "deny": [
      "Read(./app/google-services.json)",
      "Read(./local.properties)",
      "Read(./**/GoogleService-Info.plist)",
      "Read(./**/key.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.mobileprovision)"
    ],
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(firebase emulators:exec:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rm:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)"
    ]
  },
  "enabledPlugins": {
    "kotlin-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "hookify@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/scan-staged-secrets.sh",
            "if": "Bash(git commit*)",
            "timeout": 15,
            "statusMessage": "Scanning staged changes for secrets..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-review-verdict.sh",
            "if": "Bash(git push*)",
            "timeout": 15,
            "statusMessage": "Merge gate: checking the review verdict..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-green-marker.sh",
            "if": "Bash(git push*)",
            "timeout": 15,
            "statusMessage": "Merge gate: checking the green test marker..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/flag-unpushed-main.sh",
            "timeout": 15,
            "statusMessage": "Checking for unpushed commits on main..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/watch-main-ci.sh gitpush",
            "if": "Bash(git push*)",
            "timeout": 45,
            "statusMessage": "Checking for a freshly-triggered CI run on main..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/watch-main-ci.sh ghmerge",
            "if": "Bash(gh pr merge*)",
            "timeout": 45,
            "statusMessage": "Checking for a freshly-triggered CI run on main..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/subagent-log.sh",
            "timeout": 15,
            "statusMessage": "Logging the subagent result to the team log..."
          }
        ]
      }
    ]
  }
}
