rules_version = '2';

// Deploy this in the Firebase console under Firestore Database > Rules,
// or with the Firebase CLI: firebase deploy --only firestore:rules
//
// Model: every signed-in device (anonymous auth, no password) can create a new
// household. After that, only devices whose uid is listed in that household's
// `members` array can read or write its data — including the seizure log
// subcollection. Joining a household (adding your own uid to `members`) is the
// one exception: it's allowed for any signed-in user, since that's exactly how
// the "join with a code" flow works, and you can only join if you already know
// the code, which the app only reveals to members.
service cloud.firestore {
  match /databases/{database}/documents {

    // Maps a short human-typed join code -> household id. Deliberately holds nothing else
    // (no dog name, no vet info) so it's safe for any signed-in device to read by exact code
    // — that's how a new device resolves a code into a household id before it has joined
    // (and therefore before it's allowed to read the household doc itself, below).
    match /codeIndex/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /households/{householdId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members;

      // Allow existing members to update anything, OR allow a new member to add
      // *only themselves* to the members array (the join-by-code flow).
      allow update: if request.auth != null && (
                      request.auth.uid in resource.data.members ||
                      (
                        request.resource.data.members.size() == resource.data.members.size() + 1 &&
                        request.resource.data.members.hasAll(resource.data.members) &&
                        request.auth.uid in request.resource.data.members
                      )
                    );

      allow delete: if false;

      match /seizures/{seizureId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }
  }
}
