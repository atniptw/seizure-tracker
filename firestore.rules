rules_version = '2';

// Deploy this in the Firebase console under Firestore Database > Rules,
// or with the Firebase CLI: firebase deploy --only firestore:rules
//
// Model: every signed-in device (Google sign-in or anonymous, no password) can create a
// new household. After that, only devices whose uid is listed in that household's
// `members` array can read or write its data — including the seizure log
// subcollection. Joining a household (adding your own uid to `members`) is the
// one exception: it's allowed for any signed-in user, since that's exactly how
// the "join with a code" flow works, and you can only join if you already know
// the code, which the app only reveals to members.
service cloud.firestore {
  match /databases/{database}/documents {

    // Maps a short human-typed join code -> household id. Deliberately holds nothing else
    // (no dog name, no vet info) so it's safe for any signed-in device to read by exact code
    // — that's how a new device resolves a code into a household id before it has joined
    // (and therefore before it's allowed to read the household doc itself, below).
    match /codeIndex/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /households/{householdId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members;

      // Allow existing members to update anything, OR allow a new member to add
      // *only themselves* to the members array (the join-by-code flow).
      allow update: if request.auth != null && (
                      request.auth.uid in resource.data.members ||
                      (
                        request.resource.data.members.size() == resource.data.members.size() + 1 &&
                        request.resource.data.members.hasAll(resource.data.members) &&
                        request.auth.uid in request.resource.data.members
                      )
                    );

      allow delete: if false;

      match /seizures/{seizureId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      match /pets/{petId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      match /vets/{vetId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      match /petVetLinks/{linkId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      match /healthNotes/{noteId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      // Synced member metadata (display name, sign-in method) — never consulted for access
      // control, `households.members` above remains the sole source of truth for that. Doc id
      // is always the profile's own uid, so only that uid may create/edit it (prevents one
      // member overwriting another's displayName/authMethod); any current member may delete
      // another member's profile doc, since that's what makes the remove-member flow work.
      match /members/{memberUid} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;

        // No get()-based membership check here (unlike read/delete below): this doc can only
        // ever be the caller's own profile — uid == memberUid already rules out touching
        // anyone else's — and create/join flows write this doc immediately after adding the
        // uid to `households.members` in a *separate* preceding write. Requiring a fresh
        // get() of the parent here races with that write landing (two separate requests,
        // not guaranteed to serialize), so it's intentionally left out; a stray profile doc
        // under a household the caller never joined is harmless, since the read rule above
        // still hides it from everyone but real members.
        allow create, update: if request.auth != null && request.auth.uid == memberUid;

        allow delete: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }
  }
}
